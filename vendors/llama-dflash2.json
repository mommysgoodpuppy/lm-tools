{
  "$schema": "../schemas/vendor.schema.json",
  "version": 1,
  "name": "llama-dflash2",
  "description": "Vulkan llama.cpp fork pinned to the DFlash 2 implementation from upstream PR 27342",
  "checkouts": [
    {
      "name": "llama",
      "repository": "https://github.com/z-lab/llama.cpp-fork.git",
      "revision": "1deefcca395743049c3820ab8f9b15043f3e9446",
      "upstream": "https://github.com/ggml-org/llama.cpp/pull/27342",
      "path": "../vendor/llama.cpp-dflash2",
      "patches": []
    }
  ],
  "steps": [
    {
      "name": "configure Vulkan build",
      "run": [
        "cmake",
        "-S",
        "${checkout.llama}",
        "-B",
        "${checkout.llama}/build-vulkan",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DGGML_VULKAN=ON",
        "-DGGML_NATIVE=ON",
        "-DLLAMA_CURL=OFF"
      ]
    },
    {
      "name": "build llama-server",
      "run": [
        "cmake",
        "--build",
        "${checkout.llama}/build-vulkan",
        "--target",
        "llama-server",
        "-j"
      ]
    }
  ],
  "artifacts": [
    {
      "name": "llama-server",
      "path": "${checkout.llama}/build-vulkan/bin/llama-server",
      "kind": "executable"
    }
  ]
}
