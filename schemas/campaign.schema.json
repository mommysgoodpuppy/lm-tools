{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lm-tools.local/schemas/campaign.schema.json",
  "title": "lm-tools optimization campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "objective",
    "environment",
    "harness",
    "loop",
    "workspace",
    "resources",
    "evaluator"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "objective": { "$ref": "#/$defs/nonEmptyString" },
    "environment": { "$ref": "#/$defs/nonEmptyString" },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["codex-app-server", "pi-rpc"] }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["successCooldownSeconds", "failureCooldownSeconds", "restartRequestPath"],
      "properties": {
        "successCooldownSeconds": { "type": "integer", "minimum": 0 },
        "failureCooldownSeconds": { "type": "integer", "minimum": 1 },
        "restartRequestPath": { "$ref": "#/$defs/nonEmptyString" },
        "pausePath": { "$ref": "#/$defs/nonEmptyString" },
        "controllerService": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guestCheckout",
        "guestEvaluationRequest",
        "guestEvaluationResult",
        "guestEvaluationArtifactsDirectory",
        "hostBaseCheckout",
        "candidatesDirectory"
      ],
      "properties": {
        "guestCheckout": { "$ref": "#/$defs/nonEmptyString" },
        "guestEvaluationRequest": { "$ref": "#/$defs/nonEmptyString" },
        "guestEvaluationResult": { "$ref": "#/$defs/nonEmptyString" },
        "guestEvaluationArtifactsDirectory": { "$ref": "#/$defs/nonEmptyString" },
        "hostBaseCheckout": { "$ref": "#/$defs/nonEmptyString" },
        "candidatesDirectory": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockPath",
        "journalPath",
        "workerServices",
        "workerReadyUrls",
        "shutdownTimeoutSeconds",
        "vram",
        "ports"
      ],
      "properties": {
        "lockPath": { "$ref": "#/$defs/nonEmptyString" },
        "journalPath": { "$ref": "#/$defs/nonEmptyString" },
        "workerServices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "workerReadyUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "shutdownTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "vram": {
          "type": "object",
          "additionalProperties": false,
          "required": ["devicePath", "quiescentMaxMiB", "peakMaxMiB"],
          "properties": {
            "devicePath": { "$ref": "#/$defs/nonEmptyString" },
            "quiescentMaxMiB": { "type": "integer", "minimum": 0 },
            "peakMaxMiB": { "type": "integer", "minimum": 1 }
          }
        },
        "ports": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/port" }
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "device",
        "jit",
        "model",
        "contextWindow",
        "listenPort",
        "startupTimeoutSeconds",
        "request",
        "unitCommands",
        "probeRunners",
        "allowedRequestEnvironment",
        "tiers"
      ],
      "properties": {
        "python": { "$ref": "#/$defs/nonEmptyString" },
        "device": { "$ref": "#/$defs/nonEmptyString" },
        "jit": { "type": "integer", "minimum": 1 },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "size", "sha256", "metadata"],
          "properties": {
            "path": { "$ref": "#/$defs/nonEmptyString" },
            "size": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hostPath", "guestPath", "command"],
              "properties": {
                "hostPath": { "$ref": "#/$defs/nonEmptyString" },
                "guestPath": { "$ref": "#/$defs/nonEmptyString" },
                "command": { "$ref": "#/$defs/command" }
              }
            }
          }
        },
        "contextWindow": { "type": "integer", "minimum": 1 },
        "listenPort": { "$ref": "#/$defs/port" },
        "startupTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "api"],
          "properties": {
            "path": { "$ref": "#/$defs/nonEmptyString" },
            "api": { "enum": ["responses", "chat-completions"] }
          }
        },
        "unitCommands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "probeRunners": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/probeRunner" }
        },
        "allowedRequestEnvironment": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tier" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "environment"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "probeRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "executable", "allowedPathPrefixes", "timeoutSeconds", "environment"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "executable": { "$ref": "#/$defs/nonEmptyString" },
        "allowedPathPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expectedPromptTokens",
        "maxOutputTokens",
        "repeats",
        "candidateBaselineWallMs",
        "competitorWallMs",
        "expectedOutputSha256"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "maxInputChars": { "type": "integer", "minimum": 1 },
        "expectedPromptTokens": { "type": "integer", "minimum": 1 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "repeats": { "type": "integer", "minimum": 1, "maximum": 10 },
        "candidateBaselineWallMs": { "type": "number", "exclusiveMinimum": 0 },
        "competitorWallMs": { "type": "number", "exclusiveMinimum": 0 },
        "promoteBelowParentPercent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "expectedOutputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
