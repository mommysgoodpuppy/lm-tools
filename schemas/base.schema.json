{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lm-tools base runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "clients", "emergencyStop", "resources"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "clients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasoningLevels"],
      "properties": {
        "reasoningLevels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vscode", "pi"],
          "properties": {
            "vscode": { "$ref": "#/$defs/clientReasoningLevels" },
            "pi": { "$ref": "#/$defs/clientReasoningLevels" }
          }
        }
      }
    },
    "emergencyStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userUnits", "tailscaleServe"],
      "properties": {
        "userUnits": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tailscaleServe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "httpsPorts"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "httpsPorts": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu"],
      "properties": {
        "gpu": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "shared" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "conflictingExecutables",
                "shutdownGraceSeconds",
                "vram"
              ],
              "properties": {
                "mode": { "const": "exclusive" },
                "conflictingExecutables": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "shutdownGraceSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
                "vram": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["devicePath", "minimumRemainingMiB"],
                  "properties": {
                    "devicePath": { "type": "string", "minLength": 1 },
                    "minimumRemainingMiB": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "clientReasoningLevels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["none", "minimal", "low", "medium", "high", "xhigh", "max"],
      "properties": {
        "none": { "type": ["string", "null"] },
        "minimal": { "type": ["string", "null"] },
        "low": { "type": ["string", "null"] },
        "medium": { "type": ["string", "null"] },
        "high": { "type": ["string", "null"] },
        "xhigh": { "type": ["string", "null"] },
        "max": { "type": ["string", "null"] }
      }
    }
  }
}
