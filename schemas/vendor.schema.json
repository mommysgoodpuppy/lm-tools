{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lm-tools.local/schemas/vendor.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "checkouts", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "type": "string" },
    "checkouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repository", "revision", "path"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "repository": { "type": "string", "pattern": "^https://" },
          "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
          "upstream": { "type": "string", "pattern": "^https://" },
          "path": { "$ref": "#/$defs/nonEmptyString" },
          "patches": {
            "type": "array",
            "items": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run"],
        "properties": {
          "name": { "$ref": "#/$defs/nonEmptyString" },
          "run": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "cwd": { "$ref": "#/$defs/nonEmptyString" },
          "environment": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "kind"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "path": { "$ref": "#/$defs/nonEmptyString" },
          "kind": { "enum": ["file", "directory", "executable"] }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  }
}
