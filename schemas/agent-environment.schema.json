{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lm-tools.local/schemas/agent-environment.schema.json",
  "title": "lm-tools agent environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "modelDeployment",
    "seedOnCreate",
    "backend",
    "guest",
    "seeds"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "modelDeployment": { "$ref": "#/$defs/nonEmptyString" },
    "seedOnCreate": { "type": "boolean" },
    "backend": { "$ref": "#/$defs/incusBackend" },
    "guest": { "$ref": "#/$defs/guest" },
    "hostServices": {
      "type": "array",
      "items": { "$ref": "#/$defs/hostService" }
    },
    "readOnlyMounts": {
      "type": "array",
      "items": { "$ref": "#/$defs/readOnlyMount" }
    },
    "harness": {
      "oneOf": [
        { "$ref": "#/$defs/attemptHarness" },
        { "$ref": "#/$defs/serviceHarness" }
      ]
    },
    "exposure": { "$ref": "#/$defs/exposure" },
    "seeds": {
      "type": "array",
      "items": { "$ref": "#/$defs/seed" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "incusBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "executable",
        "instance",
        "image",
        "network",
        "limits",
        "modelAccess"
      ],
      "properties": {
        "kind": { "const": "incus" },
        "executable": { "$ref": "#/$defs/nonEmptyString" },
        "instance": { "$ref": "#/$defs/nonEmptyString" },
        "image": { "$ref": "#/$defs/nonEmptyString" },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "device"],
          "properties": {
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "device": { "$ref": "#/$defs/nonEmptyString" },
            "address": {
              "type": "string",
              "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory", "processes"],
          "properties": {
            "cpu": { "type": "integer", "minimum": 1 },
            "memory": { "$ref": "#/$defs/nonEmptyString" },
            "processes": { "type": "integer", "minimum": 1 }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["createIfMissing", "deleteProtection", "autostart"],
          "properties": {
            "createIfMissing": { "type": "boolean" },
            "deleteProtection": { "type": "boolean" },
            "autostart": { "type": "boolean" }
          }
        },
        "modelAccess": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port"],
          "properties": {
            "host": { "$ref": "#/$defs/nonEmptyString" },
            "port": { "$ref": "#/$defs/port" }
          }
        }
      }
    },
    "guest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "uid", "gid", "home", "workspace", "packages"],
      "properties": {
        "user": { "$ref": "#/$defs/nonEmptyString" },
        "uid": { "type": "integer", "minimum": 1 },
        "gid": { "type": "integer", "minimum": 1 },
        "home": { "$ref": "#/$defs/nonEmptyString" },
        "workspace": { "$ref": "#/$defs/nonEmptyString" },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "administration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passwordlessSudo", "linger"],
          "properties": {
            "passwordlessSudo": { "type": "boolean" },
            "linger": { "type": "boolean" }
          }
        },
        "npmPackages": {
          "type": "array",
          "items": { "$ref": "#/$defs/npmPackage" }
        }
      }
    },
    "npmPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "allowLifecycleScripts"],
      "oneOf": [
        {
          "required": ["integrity"],
          "properties": { "integrity": true, "source": false }
        },
        {
          "required": ["source"],
          "properties": { "source": true, "integrity": false }
        }
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "allowLifecycleScripts": { "type": "boolean" }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "exclude", "policy"],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "policy": { "enum": ["create", "refresh", "manual"] },
        "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "readOnlyMount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "target"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "hostService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "enabled", "running", "restartOnRefresh"],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "enabled": { "type": "boolean" },
        "running": { "type": "boolean" },
        "restartOnRefresh": { "type": "boolean" },
        "environmentInputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/environmentInput" }
        }
      }
    },
    "attemptHarness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "adapter",
        "prompt",
        "state",
        "metricsDirectory",
        "liveNoticePath",
        "dashboardPort",
        "timeoutSeconds",
        "cooldownSeconds",
        "progressRepositories",
        "cleanupProcesses"
      ],
      "properties": {
        "kind": { "const": "turn-loop" },
        "adapter": { "enum": ["exec-json", "app-server", "pi-rpc", "omp-rpc"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "prompt": { "$ref": "#/$defs/nonEmptyString" },
        "state": { "$ref": "#/$defs/nonEmptyString" },
        "metricsDirectory": { "$ref": "#/$defs/nonEmptyString" },
        "liveNoticePath": { "$ref": "#/$defs/nonEmptyString" },
        "dashboardPort": { "$ref": "#/$defs/port" },
        "timeoutSeconds": { "type": "integer", "minimum": 60 },
        "wrapUpSeconds": { "type": "integer", "minimum": 30 },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "maxPerSession", "reminderTokens"],
          "properties": {
            "mode": { "enum": ["model-directed"] },
            "maxPerSession": { "type": "integer", "minimum": 1, "maximum": 16 },
            "reminderTokens": { "type": "integer", "minimum": 1024 }
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "prompt",
              "timeoutSeconds",
              "wrapUpSeconds",
              "requiredChangedFiles"
            ],
            "properties": {
              "name": { "$ref": "#/$defs/nonEmptyString" },
              "prompt": { "$ref": "#/$defs/nonEmptyString" },
              "timeoutSeconds": { "type": "integer", "minimum": 60 },
              "wrapUpSeconds": { "type": "integer", "minimum": 30 },
              "finalizeTimeoutSeconds": { "type": "integer", "minimum": 60 },
              "requiredChangedFiles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/nonEmptyString" }
              }
            }
          }
        },
        "phaseControl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestPath", "maxTransitions", "maxWallSeconds", "finalPhase"],
          "properties": {
            "requestPath": { "$ref": "#/$defs/nonEmptyString" },
            "maxTransitions": { "type": "integer", "minimum": 1, "maximum": 128 },
            "maxWallSeconds": { "type": "integer", "minimum": 300, "maximum": 86400 },
            "finalPhase": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "turnSummary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "model",
            "reasoningEffort",
            "timeoutSeconds",
            "maxInputChars",
            "maxOutputTokens"
          ],
          "properties": {
            "endpoint": { "$ref": "#/$defs/nonEmptyString" },
            "model": { "$ref": "#/$defs/nonEmptyString" },
            "reasoningEffort": { "enum": ["none", "low", "medium", "high"] },
            "timeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 600 },
            "maxInputChars": { "type": "integer", "minimum": 4000, "maximum": 200000 },
            "maxOutputTokens": { "type": "integer", "minimum": 256, "maximum": 4096 }
          }
        },
        "cooldownSeconds": { "type": "integer", "minimum": 0 },
        "progressRepositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "cleanupProcesses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "serviceHarness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "command",
        "unit",
        "restart",
        "restartSeconds",
        "restartPreventExitStatuses",
        "ready",
        "restartOnRefresh"
      ],
      "properties": {
        "kind": { "const": "service" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "environment": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        },
        "environmentInputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/environmentInput" }
        },
        "secretInputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/secretInput" }
        },
        "setup": {
          "type": "array",
          "items": { "$ref": "#/$defs/setupStep" }
        },
        "unit": { "type": "string", "pattern": "^[A-Za-z0-9_.@-]+\\.service$" },
        "restart": { "enum": ["no", "on-failure", "always"] },
        "restartSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "restartPreventExitStatuses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "ready": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "timeoutSeconds"],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
          }
        },
        "restartOnRefresh": { "type": "boolean" }
      }
    },
    "environmentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "key"],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "key": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
      }
    },
    "secretInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "key", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "key": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
        "target": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "setupStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "check", "command"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "check": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "checkJson": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pointer", "equals"],
            "properties": {
              "pointer": { "type": "string", "pattern": "^/" },
              "equals": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "number" },
                  { "type": "boolean" },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "registryIntegrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "version", "integrity"],
          "properties": {
            "package": { "type": "string", "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$" },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
            },
            "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" }
          }
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["services"],
      "properties": {
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/exposedService" }
        }
      }
    },
    "exposedService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "oneOf": [
        { "required": ["guestPort"], "properties": { "guestPort": true } },
        { "required": ["upstream"], "properties": { "upstream": true } }
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "guestPort": { "$ref": "#/$defs/port" },
        "upstream": { "type": "string", "pattern": "^http://\\S+$" },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "port"],
          "properties": {
            "address": { "const": "127.0.0.1" },
            "port": { "$ref": "#/$defs/port" }
          }
        },
        "tailscaleServe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "executable", "httpsPort"],
          "properties": {
            "enabled": { "const": true },
            "executable": { "$ref": "#/$defs/nonEmptyString" },
            "httpsPort": { "$ref": "#/$defs/port" }
          }
        }
      }
    }
  }
}
