{
  "tasks": {
    "lm": "deno run -A main.ts",
    "check": "deno check main.ts src/**/*.ts",
    "test": "deno test -A",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
