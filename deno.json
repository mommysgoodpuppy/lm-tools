{
  "tasks": {
    "lm": "deno run -A main.ts",
    "kill-everything": "deno run -A main.ts kill-everything",
    "t3code:build": "deno run --allow-read --allow-write --allow-run=node,corepack scripts/build_t3code.ts",
    "check": "deno check main.ts src/**/*.ts scripts/**/*.ts",
    "test": "deno test -A src/",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["vendor/"]
  },
  "lint": {
    "exclude": ["vendor/"],
    "rules": {
      "tags": ["recommended"]
    }
  }
}
