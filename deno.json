{
  "tasks": {
    "lm": "deno run -A main.ts",
    "kill-everything": "deno run -A main.ts kill-everything",
    "ps2-campaign": "bash scripts/ps2_campaign.sh",
    "tinygrad:vendor": "deno run -A main.ts vendor vendors/tinygrad-rdna3-qwen.json",
    "codex:vendor": "deno run -A main.ts vendor vendors/codex-local-compact.json",
    "codex:smoke-compaction": "deno run -A scripts/smoke_codex_compaction.ts",
    "codex:smoke-semantic-compaction": "deno run -A scripts/smoke_codex_semantic_compaction.ts",
    "pi:smoke-rpc": "deno run -A scripts/smoke_pi_rpc.ts",
    "pi:vendor": "deno run -A main.ts vendor vendors/pi-rpc.json",
    "dflash2:vendor": "deno run -A main.ts vendor vendors/llama-dflash2.json",
    "llama-vulkan-reference:vendor": "deno run -A main.ts vendor vendors/llama-vulkan-reference.json",
    "diffusiongemma:vendor": "deno run -A main.ts vendor vendors/diffusiongemma.json",
    "t3code:build": "deno run --allow-read --allow-write --allow-run=node,corepack scripts/build_t3code.ts",
    "check": "deno check main.ts src/**/*.ts scripts/**/*.ts",
    "test": "deno test -A src/",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["vendor/"]
  },
  "lint": {
    "exclude": ["vendor/"],
    "rules": {
      "tags": ["recommended"]
    }
  }
}
